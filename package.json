{
  "name": "isecure-ts-client",
  "version": "5.0.3",
  "description": "TypeScript SDK for the ISECure WS Channel API",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isecurefi/isecure-ts-client.git"
  },
  "bugs": {
    "url": "https://github.com/isecurefi/isecure-ts-client/issues"
  },
  "homepage": "https://github.com/isecurefi/isecure-ts-client#readme",
  "keywords": [
    "isecure",
    "ws-channel",
    "banking",
    "sepa",
    "typescript",
    "sdk"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./wsapi-types": {
      "types": "./dist/generated/wsapi-v2.d.ts",
      "browser": "./dist/generated/wsapi-v2.js",
      "import": "./dist/generated/wsapi-v2.js"
    },
    "./iso20022": {
      "types": "./dist/iso20022/index.d.ts",
      "browser": "./dist/iso20022/index.js",
      "import": "./dist/iso20022/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "browser": "./dist/platform/index.js",
      "import": "./dist/platform/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "STABILITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "clean": "rm -rf dist dist-examples coverage .generated .browser-check docs-api",
    "docs": "yarn generate:types && npx -y typedoc",
    "generate:types": "mkdir -p .generated src/generated && swagger2openapi wsapi_v2.json -o .generated/wsapi_v2.openapi.json && openapi-typescript .generated/wsapi_v2.openapi.json -o src/generated/wsapi-v2.ts && swagger2openapi provider-api.json -o .generated/provider-api.openapi.json && openapi-typescript .generated/provider-api.openapi.json -o src/generated/provider-api.ts && swagger2openapi transfer-api.json -o .generated/transfer-api.openapi.json && openapi-typescript .generated/transfer-api.openapi.json -o src/generated/transfer-api.ts",
    "sync:platform-contracts": "node scripts/sync-platform-contracts.mjs --write",
    "check:platform-contracts": "node scripts/sync-platform-contracts.mjs --check",
    "build": "rm -rf dist && yarn generate:types && tsc -p tsconfig.json",
    "build:examples": "rm -rf dist-examples && tsc -p tsconfig.examples.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "yarn generate:types && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "browser:check": "vite build --config vite.browser.config.ts",
    "pack:check": "yarn build && NPM_CONFIG_CACHE=${TMPDIR:-/tmp}/isecure-npm-cache npm pack --dry-run",
    "prepublishOnly": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn browser:check && yarn pack:check",
    "example:workflow": "yarn build:examples && node dist-examples/examples/full-workflow/full-workflow.js",
    "example:processing-upload": "yarn build:examples && node dist-examples/examples/processing-manual-upload/processing-manual-upload.js",
    "example:processing-generate-file": "yarn build:examples && node dist-examples/examples/processing-generate-file/generate-file.js",
    "example:processing-simulator": "yarn build:examples && node dist-examples/examples/processing-simulator-journey/processing-simulator-journey.js",
    "example:simulator": "yarn build:examples && node dist-examples/examples/bank-simulator/bank-simulator.js",
    "test:live": "yarn build:examples && node dist-examples/examples/live-suite/cli.js",
    "sync:provider-contract": "node scripts/sync-provider-contract.mjs --write",
    "check:provider-contract": "node scripts/sync-provider-contract.mjs",
    "test:providers:read": "yarn build:examples && node dist-examples/examples/provider-qualification/cli.js read",
    "test:providers:lifecycle": "yarn build:examples && node dist-examples/examples/provider-qualification/cli.js lifecycle",
    "sync:transfer-contract": "node scripts/sync-transfer-contract.mjs --write",
    "check:transfer-contract": "node scripts/sync-transfer-contract.mjs",
    "sync:transfer-vectors": "node scripts/sync-transfer-aead-vectors.mjs --write",
    "check:transfer-vectors": "node scripts/sync-transfer-aead-vectors.mjs",
    "sync:encrypted-transfer-contract": "node scripts/sync-encrypted-transfer-contract.mjs --write",
    "check:encrypted-transfer-contract": "node scripts/sync-encrypted-transfer-contract.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "openpgp": "6.3.1",
    "prettier": "^3.9.6",
    "rolldown": "1.2.15",
    "swagger2openapi": "^7.0.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.3",
    "vitest": "^4.1.12"
  },
  "resolutions": {
    "js-yaml": "^4.3.2",
    "**/eslint/minimatch": "^11.0.4",
    "**/@eslint/config-array/minimatch": "^11.0.4",
    "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.4"
  }
}
